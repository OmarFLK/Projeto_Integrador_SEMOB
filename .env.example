# Exemplos apenas. O Compose lê .env; Dart/Flutter não carregam .env automaticamente.
SEMOB_ENV=development
SEMOB_ADMIN_EMAIL=admin@semob.local
SEMOB_ADMIN_PASSWORD=
# PostgreSQL local do Compose: senha forte URL-safe (letras, números, _ e -).
POSTGRES_PASSWORD=
# Para Dart/Render: URL pooled do Neon; direta para migrações/backup.
# Remova channel_binding=require (driver sem SCRAM-PLUS); TLS verifica o certificado/host.
DATABASE_URL=postgresql://USUARIO:SENHA@SEU-ENDPOINT-pooler.REGIAO.aws.neon.tech/semob_users?sslmode=verify-full
DIRECT_DATABASE_URL=postgresql://USUARIO:SENHA@SEU-ENDPOINT.REGIAO.aws.neon.tech/semob_users?sslmode=verify-full
# Em produção, MongoDB/Atlas é obrigatório; Compose usa seu Mongo interno.
SEMOB_MONGODB_URI=
MONGO_ROOT_PASSWORD=
# No Compose, use senha forte URL-safe (letras, números, _ e -).
MONGO_APP_PASSWORD=
SEMOB_ALLOWED_ORIGINS=http://localhost:8080
# Endpoint exato da IA existente. Deixe sem valor enquanto não houver contrato confirmado.
SEMOB_AI_URL=
SEMOB_AI_API_KEY=
SEMOB_AI_REQUEST_FIELD=message
SEMOB_AI_RESPONSE_FIELD=answer
# Serviço responsável por enviar o código por e-mail.
SEMOB_RECOVERY_WEBHOOK=
SEMOB_RECOVERY_WEBHOOK_KEY=
